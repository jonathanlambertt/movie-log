# Copy to .env and fill in from Supabase dashboard → Project Settings → Data API.
# EXPO_PUBLIC_* vars are inlined into the app bundle — never put secrets here.
# (The TMDB key lives in `supabase secrets`, not in this file.)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
